    { "source": "/contact-macon.htm", "destination": "/contact/", "permanent": true },

    { "source": "/4kids.htm", "destination": "/about/", "permanent": true },
    { "source": "/careers.htm", "destination": "/", "permanent": true },
    { "source": "/blog.htm", "destination": "/", "permanent": true },

    { "source": "/inventory/", "destination": "https://inventory.nationwidehaul.com/", "permanent": true },
